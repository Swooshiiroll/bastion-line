	"warp_core": {"title": "Warp gates and the core", "category": "battlefield", "see": ["rules_modes"],
		"text": "Enemies arrive through warp gates and follow the lanes to the core. Each one that reaches it costs core shields; flyers take their own straight air lane. When the shields run out the sector falls."},

	# --- Rules ----------------------------------------------------------------------------------------
	"trees": {"title": "Upgrade trees", "category": "rules", "see": ["primary", "mastery"],
		"text": "Every tower is built as its Stock model and upgraded once to its Retrofit. Then three branches open (A, B and C on U, I and O), each running T1 to T4 and ending in a Mastery. T1 is the specialization, which changes how the tower works."},
	"primary": {"title": "Primary and secondary branches", "category": "rules", "see": ["trees"],
		"text": "A tower can climb two branches freely, up to two upgrades each. The first to reach its third upgrade becomes the primary and can go on to its Mastery; the other becomes the secondary, capped at {secondary_cap} upgrades, and the third branch locks as soon as two are started. A secondary keeps its full effects, and attack-changing secondaries add their attack alongside the primary's. A tower keeps its stock name and colour until its primary locks in."},
	"mastery": {"title": "Masteries", "category": "rules", "see": ["research"],
