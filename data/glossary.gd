	"barrier_grant": {"title": "Barrier grants", "category": "effects", "see": ["barrier", "jam"],
		"text": "Bulwarks project a barrier onto nearby enemies every few seconds. Some upgrades (Maelstrom storms, jamming pylons) stop enemies inside their fields from receiving it."},
	"emp": {"title": "EMP", "category": "effects", "see": ["jam", "suppress"],
		"text": "Jammers fire an EMP that knocks nearby towers offline for a moment. Kill them from range, or suppress or jam them."},
	"split": {"title": "Splitting and spawning", "category": "effects", "see": [],
		"text": "Hydra Frames split into Skitters when destroyed. The Overmind spawns Nanites and the Leviathan launches Locust swarms as they advance, and the Colossus drops Siege Mechs each time it sheds armor."},

