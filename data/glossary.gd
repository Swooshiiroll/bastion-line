	"burrow": {"title": "Burrowing", "category": "effects", "see": ["disrupt"],
		"text": "Burrowers dive under the lane for part of every cycle: they can't be targeted or hurt, and hazards don't touch them. Hit them when they surface, keep them up with disrupt or suppression, or use upgrades that hit burrowed enemies."},
	"blink": {"title": "Blink", "category": "effects", "see": ["slow", "stun", "disrupt"],
		"text": "Blink Stalkers teleport a stretch down the lane on a timer. Slowing or stunning one resets its charge, and disrupting or suppressing it stops blinking altogether."},
	"regen": {"title": "Repair and regeneration", "category": "effects", "see": ["suppress", "jam"],
		"text": "Repair Bots heal nearby enemies on a timer, and Mender Hulks regenerate after a moment without damage. Keep damage flowing, kill the healers first, or block repairs with Cryo Lock, jamming or suppression."},
	"haste": {"title": "Haste aura", "category": "effects", "see": ["jam"],
