extends RefCounted
## The Codex's hand-written entries: status effects, battlefield features and game rules. Towers and
## enemies are generated from their own data (see scripts/core/Lore.gd).
## Numbers are never typed here: `{name}` placeholders are filled from the game's constants by
## Lore.values(), so the text can't drift from the rules.

const CATEGORIES := ["towers", "enemies", "effects", "battlefield", "rules"]
const CATEGORY_NAMES := {
	"towers": "Towers", "enemies": "Enemies", "effects": "Effects", "battlefield": "Battlefield", "rules": "Rules",
}

## id -> {title, category, text, see}
const ENTRIES := {
	# --- Effects ------------------------------------------------------------------------------------
	"armor": {"title": "Armor", "category": "effects", "see": ["shred", "armor_break", "pierce"],
		"text": "Armor removes that much damage from every hit, down to a floor of {min_damage}% of the hit. It hurts fast, weak attacks the most: a 9-damage bolt against 6 armor deals 3. Big single hits, beams that ignore armor, Shredders and armor breaks are the answer."},
	"pierce": {"title": "Armor piercing", "category": "effects", "see": ["armor"],
		"text": "Some attacks ignore armor entirely: Railgun slugs, Laser Lance beams, burning pools and burns, lane shock strips, the Orbital Strike, and any upgrade that says it pierces armor."},
	"shred": {"title": "Shred", "category": "effects", "see": ["armor", "armor_break"],
		"text": "Shredding hits strip armor permanently, a little per hit, up to the attack's maximum. Stripped armor stays gone for every tower, so one Shredder helps the whole line against Siege Mechs, Ramparts and Dreadnoughts."},
	"armor_break": {"title": "Armor break", "category": "effects", "see": ["armor", "shred"],
		"text": "A temporary armor reduction (Bunker Buster shells, the Nullifier's Purge line). It stacks with shred but wears off after a few seconds; a stronger break replaces a weaker one."},
	"barrier": {"title": "Barrier", "category": "effects", "see": ["barrier_grant", "strip"],
		"text": "An energy barrier soaks damage before the hull, and armor doesn't reduce hits on it. It recharges after a short time without damage. Arc Coils hit barriers twice as hard, some upgrades deal extra damage to barriers or bypass them, and Nullifiers strip them."},
	"strip": {"title": "Barrier strip", "category": "effects", "see": ["barrier"],
		"text": "Nullifier pulses remove a share of every barrier in their field at once, and some upgrades stop barriers from recharging or from being granted while enemies are inside."},
	"slow": {"title": "Slow", "category": "effects", "see": ["stun", "cc_immune", "boss_rules"],
		"text": "Slows reduce movement speed; the strongest active slow applies, capped at {slow_cap}%. Some enemies resist part of every slow, and crowd-control-immune enemies ignore them unless exposed. Slowing a Blink Stalker resets its blink charge."},
	"stun": {"title": "Stun", "category": "effects", "see": ["slow", "boss_rules", "cc_immune"],
		"text": "A stunned enemy stops moving (and a Blink Stalker's charge resets). When a stun ends, the enemy can't be stunned again for {stun_guard} s, so chained stuns can never pin it forever. Bosses are stunned for only {boss_stun}% as long."},
	"shove": {"title": "Shove and pull", "category": "effects", "see": ["boss_rules", "cc_immune"],
		"text": "Graviton pulses shove ground enemies back along the lane, and Gravity Wells pull them together. Each enemy can be shoved back at most {shove_budget} px in total, so every enemy keeps making progress. Bosses move {boss_push}% as far."},
	"burn": {"title": "Burn", "category": "effects", "see": ["pierce"],
		"text": "Burning pools and burns deal damage every second for a few seconds and ignore armor. Plasma Mortars leave pools on the ground; Solar Flare and Corona set enemies alight around the Nova Reactor."},
	"vuln": {"title": "Vulnerability", "category": "effects", "see": ["mark"],
		"text": "Vulnerable enemies take extra damage from every source for a while (Shatter Field chills, Sensor marks). Vulnerability doesn't stack: the strongest active one applies."},
	"mark": {"title": "Damage mark", "category": "effects", "see": ["vuln", "cloak"],
		"text": "Sensor Arrays mark every enemy in their field to take extra damage from everything, and Hunter-Killer drones mark their targets. Marks are a kind of vulnerability, so the strongest one applies."},
	"suppress": {"title": "Suppression", "category": "effects", "see": ["jam", "expose"],
		"text": "A suppressed enemy's abilities switch off: no repairs, EMPs, barrier grants, spawning, burrowing or blinking. Null Slugs, the Dampener and Assassin drones suppress; most don't work on bosses, and some upgrades suppress bosses at half strength."},
	"jam": {"title": "Jamming", "category": "effects", "see": ["suppress", "emp"],
		"text": "Suppression Pylons jam enemy support inside their field: repairs, haste auras and barrier grants stop. The Silence Pylon jams everything, including Jammer EMPs and boss launches."},
	"expose": {"title": "Expose", "category": "effects", "see": ["cc_immune", "slow", "stun"],
		"text": "Exposed enemies lose their crowd-control immunity for a while, so Ramparts and the Colossus can be slowed, stunned and shoved. The Nullifier and some Sensor and Railgun upgrades expose."},
	"disrupt": {"title": "Disrupt", "category": "effects", "see": ["burrow", "blink", "cloak"],
		"text": "Disrupted enemies can't burrow or blink, and their cloak fails, so every tower can target them. The Disruptor Sensor line disrupts everything in its field."},
