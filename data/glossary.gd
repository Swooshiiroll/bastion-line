	# --- Rules ----------------------------------------------------------------------------------------
	"trees": {"title": "Upgrade trees", "category": "rules", "see": ["primary", "mastery"],
		"text": "Every tower is built as its Stock model. Its Retrofit (Y, then 1 to 3) is a choice of three, locked once fitted. Three paths are open from the start (A, B and C on U, I and O), each running T1 to T4 and ending in a Mastery."},
	"primary": {"title": "Primary and secondary branches", "category": "rules", "see": ["trees"],
		"text": "A tower can climb two paths freely, up to two upgrades each. The first to reach its third upgrade becomes the primary and can go on to its Mastery; the other becomes the secondary, capped at {secondary_cap} upgrades, and the third path locks as soon as two are started. The CAS Gunship is the exception: every path takes every upgrade and its own Mastery."},
	"mastery": {"title": "Masteries", "category": "rules", "see": ["research"],
		"text": "A path's Mastery needs that tower's Mastery research in the Research Lab, which in turn needs the rest of that tower's research tree. One Mastery research unlocks all of the tower's masteries."},
	"targeting": {"title": "Targeting and priority", "category": "rules", "see": [],
		"text": "T cycles a tower's target: First (furthest along), Last, Strongest or Closest. Strongest goes by an enemy's strength (its speed, armour and health; every boss is stronger than any other enemy), then by its health left, then by how far along it is. G sets a priority: Any, Support (Support enemies first: Repair Bots, Rally Beacons, Bulwarks, Mender Hulks), and for towers that hit both air and ground, Air or Ground. Among the enemies it prefers, a tower still uses its target mode, and it shoots the rest when none of those are in range."},
	"elites": {"title": "Elites and modifiers", "category": "rules", "see": ["targeting", "scaling"],
		"text": "From round 10 some enemies arrive as elites: a single enemy with a gold ring and a label naming its modifiers. Shielded (a recharging barrier worth half its health), Hasty (+35% speed), Regenerating (repairs 3% a second when left alone), Plated (+4 armor), Cloaked, Splitting (breaks into two of the tier below), Jamming (an EMP every 6 s), Resolute (resists half of every slow, can't be stunned) and Commanding (others nearby +15% speed). An elite carries one modifier, up to two from round 40 and three from round 80; it pays double bounty and costs one more shield if it leaks. Hasty and Plated raise its strength for Strongest targeting. The Intel panel lists the next round's elites."},
	"footprint": {"title": "Big towers", "category": "rules", "see": ["high_ground", "power_node"],
		"text": "The Scrapyard takes a 2x2 block of tiles. The build preview centres the block on the cursor, and the tower gets a high-ground or power-node bonus if any of its tiles has one."},
	"selling": {"title": "Selling", "category": "rules", "see": ["economy"],
		"text": "Selling refunds {sell}% of everything spent on the tower (more with Salvage Protocols research, and more inside a Scrapyard's field with its sell-back upgrades)."},
	"economy": {"title": "Credits", "category": "rules", "see": ["scaling", "selling"],
		"text": "Every run starts with {start_gold} credits (more with Reserve Funds). Kills pay their bounty, which grows with the round (bounty x the round's health multiplier^{bounty_exp}). Clearing a round pays 20 + 3 x round credits, calling the next round early pays 10 + 2 x round, and Scrapyards pay out at every round clear."},
	"scaling": {"title": "Round scaling", "category": "rules", "see": ["economy", "rules_modes"],
		"text": "Enemy health grows every round and compounds faster from round {late_start}; speed grows a little each round (bosses half as much). Kill credits grow with health, so the economy keeps up."},
	"rules_modes": {"title": "Difficulty modes and medals", "category": "rules", "see": ["research"],
		"text": "Easy, Medium, Hard, Nightmare and Cataclysm set the number of rounds, your core shields and tower prices. Clearing a mode's last round earns the sector's medal for that mode, and endless mode starts right away."},
	"research": {"title": "Research", "category": "rules", "see": ["mastery", "rules_modes"],
		"text": "Research points come from your records: medals, reaching rounds 20, 40, 60, 80 and 100 on a sector, and endless rounds. Research applies at once, even mid-run, and can be reset for free."},
	"abilities": {"title": "Orbital Strike and Chrono Field", "category": "rules", "see": ["boss_rules"],
		"text": "Q calls an Orbital Strike on a spot: {meteor_damage} armor-ignoring damage (growing each round) in {meteor_radius} px after {meteor_delay} s, every {meteor_cd} s. W opens a Chrono Field: every enemy is slowed {warp_slow}% for {warp_time} s (bosses resist half), every {warp_cd} s. Both recharge only while a round is running."},
}
