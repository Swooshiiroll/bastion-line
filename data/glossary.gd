	"expose": {"title": "Expose", "category": "effects", "see": ["cc_immune", "slow", "stun"],
		"text": "Exposed enemies lose their crowd-control immunity for a while, so Ramparts and the Colossus can be slowed, stunned and shoved."},
	"disrupt": {"title": "Disrupt", "category": "effects", "see": ["burrow", "blink", "cloak"],
