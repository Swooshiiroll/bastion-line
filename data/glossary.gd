	"shove": {"title": "Shove and pull", "category": "effects", "see": ["boss_rules", "cc_immune"],
		"text": "Some towers move enemies back along the lane: the Tractor Tower grabs one and hauls it back. Each enemy can be shoved back at most {shove_budget} px in total, so every enemy keeps making progress. Bosses move {boss_push}% as far."},
	"burn": {"title": "Burn", "category": "effects", "see": ["pierce"],
