extends RefCounted
## The Codex's hand-written entries: status effects, battlefield features and game rules. Towers and
## enemies are generated from their own data (see scripts/core/Lore.gd).
## Numbers are never typed here: `{name}` placeholders are filled from the game's constants by
## Lore.values(), so the text can't drift from the rules.

const CATEGORIES := ["towers", "enemies", "effects", "battlefield", "rules"]
const CATEGORY_NAMES := {
	"towers": "Towers", "enemies": "Enemies", "effects": "Effects", "battlefield": "Battlefield", "rules": "Rules",
}

## id -> {title, category, text, see}
const ENTRIES := {
	# --- Effects ------------------------------------------------------------------------------------
	"armor": {"title": "Armor", "category": "effects", "see": ["shred", "armor_break", "pierce"],
		"text": "Armor removes that much damage from every hit, down to a floor of {min_damage}% of the hit. It hurts fast, weak attacks the most: a 9-damage round against 6 armor deals 3. Big single hits, armor-piercing rounds and towers that strip armor are the answer."},
	"pierce": {"title": "Armor piercing", "category": "effects", "see": ["armor"],
